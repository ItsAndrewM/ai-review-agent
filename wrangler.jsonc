{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "andabot",
  "main": "src/index.ts",
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },
  // Repository search loads the head's files into the object: a vscode-size
  // snapshot took 8.2 s of CPU to load, and grep's work budget and the
  // snapshot cap hold the costliest measured call to about 15 s. 300 s is the
  // maximum, so several calls in one event can't reset the object.
  "limits": { "cpu_ms": 300000 },
  "ai": { "binding": "AI", "remote": true },
  // The running build's id and timestamp, so an object can tell it is older
  // than the Worker that called it during the eventually-consistent rollout.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": {
    // The GitHub App's login, without the [bot] suffix. People tag @andabot.
    "BOT_LOGIN": "andabot",
    // Workers AI model for the review. GLM-5.3 Flash caught all five of #9's
    // planted defects and posts through the tool, for under a cent a review
    // (#2). GLM 5.x, Kimi K2.7 Code and DeepSeek V4 need the Workers Paid
    // plan; gpt-oss-120b and glm-4.7-flash run on Free.
    "REVIEW_MODEL": "@cf/zai-org/glm-5.3-flash",
    // How hard the review model thinks: off, minimal, low, medium, high, xhigh
    // or max. Measured on #37, #23 at d1bd6f7, in #34.
    "REVIEW_THINKING_LEVEL": "low",
    // Most output tokens one model call may ask for, reasoning included. The
    // model's own maximum and its context still cap it. A review's
    // submit_review call grows with its findings, so raise it for large pull
    // requests whose reviews get cut off.
    "MAX_OUTPUT_TOKENS": "16000",
    // "true": request changes on blocking findings and approve clean PRs.
    // "false": only ever comment.
    "REQUEST_CHANGES_WORKFLOW": "true",
    // Workers AI model for the verify pass (#31), which re-checks each finding
    // before it posts. Empty keeps verify off everywhere, whatever a
    // repository's .andabot.yaml says, and stays empty until #31's measurement
    // picks a default.
    "VERIFY_MODEL": "",
  },
  // Secrets, set with `wrangler secret put <NAME>` or in .dev.vars locally:
  //   GITHUB_APP_ID          the App's numeric id
  //   GITHUB_PRIVATE_KEY     the App's private key, PEM, newlines kept
  //   GITHUB_WEBHOOK_SECRET  the App's webhook secret
  "durable_objects": {
    "bindings": [{ "name": "PULL_REQUEST", "class_name": "PullRequest" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PullRequest"] }],
}
