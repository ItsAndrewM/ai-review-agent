{
  "name": "andabot",
  "version": "0.0.1",
  "private": true,
  "description": "A self-hosted pull request reviewer on Cloudflare: a Worker, a Durable Object per PR, and Pi Durable as the agent loop.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint --disable-nested-config . && oxfmt --disable-nested-config --check .",
    "format": "oxfmt --disable-nested-config .",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "agents": "0.28.1",
    "typebox": "1.3.27",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@gamesheet-inc/oxlint-plugin": "0.2.0",
    "@oxlint/plugins": "1.88.0",
    "@types/node": "^22",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "4.151.1"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "workerd",
      "esbuild"
    ]
  }
}
